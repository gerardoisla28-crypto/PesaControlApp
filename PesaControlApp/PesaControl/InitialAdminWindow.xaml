<Window x:Class="PesaControl.UI.InitialAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Configuración inicial" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Margin" Value="2,3,0,6" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="28">
        <TextBlock Text="Crear Admin" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Text="Esta cuenta administrará los usuarios." TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <TextBlock Text="Usuario *" Margin="0,0,0,4" />
        <TextBox x:Name="UsernameBox"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Ej: AdminJuan"
                 materialDesign:HintAssist.IsFloating="False" />
        <TextBlock x:Name="UsernameError" Style="{StaticResource FieldError}" />

        <TextBlock Text="Nombre y apellido *" Margin="0,0,0,4" />
        <TextBox x:Name="FullNameBox"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Ej: Juan Pérez"
                 materialDesign:HintAssist.IsFloating="False" />
        <TextBlock x:Name="FullNameError" Style="{StaticResource FieldError}" />

        <TextBlock x:Name="PasswordLabel" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox"
                     Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="Escriba una contraseña segura"
                     materialDesign:HintAssist.IsFloating="False" />
        <TextBlock x:Name="PasswordError" Style="{StaticResource FieldError}" />

        <TextBlock Text="Confirmar contraseña *" Margin="0,0,0,4" />
        <PasswordBox x:Name="ConfirmPasswordBox"
                     Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="Repita la contraseña"
                     materialDesign:HintAssist.IsFloating="False" />
        <TextBlock x:Name="ConfirmPasswordError" Style="{StaticResource FieldError}" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource FieldError}" Margin="0,0,0,6" MinHeight="0" />
        <TextBlock Text="* Campos obligatorios" FontSize="12" Margin="0,4,0,16"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Content="Crear Admin" Click="Create_Click" HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButton}" Padding="16,8" />
    </StackPanel>
</Window>
