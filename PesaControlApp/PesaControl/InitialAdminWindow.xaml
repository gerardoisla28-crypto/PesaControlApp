<Window x:Class="PesaControl.UI.InitialAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración inicial" Height="350" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="28">
        <TextBlock Text="Crear administrador del cliente" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Text="Esta cuenta administra los usuarios del cliente. Debe ser diferente de la cuenta de soporte." TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="Usuario" />
        <TextBox x:Name="UsernameBox" Margin="0,4,0,10" />
        <TextBlock Text="Nombre completo (opcional)" />
        <TextBox x:Name="FullNameBox" Margin="0,4,0,10" />
        <TextBlock Text="Contraseña (14 a 128 caracteres)" />
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,16" />
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button Content="Crear administrador" Click="Create_Click" HorizontalAlignment="Right" Padding="16,8" />
    </StackPanel>
</Window>
