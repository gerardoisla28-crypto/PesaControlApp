<Window x:Class="PesaControl.UI.StationCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Configuración inicial" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Margin" Value="2,3,0,6" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="28">
        <TextBlock Text="Código del puesto" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock x:Name="ExamplesText" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="Código (1 a 4 caracteres) *" Margin="0,0,0,4" />
        <TextBox x:Name="CodeBox" MaxLength="4" CharacterCasing="Upper"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Ej: STGO o RM"
                 materialDesign:HintAssist.IsFloating="False" />
        <TextBlock x:Name="CodeError" Style="{StaticResource FieldError}" />

        <TextBlock Text="Si la empresa tiene varios puestos, cada uno debe tener un código distinto."
                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                   Foreground="{StaticResource AccentOrangeBrush}" />
        <TextBlock Text="* Campos obligatorios" FontSize="12" Margin="0,4,0,16"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Content="Guardar" Click="Save_Click" HorizontalAlignment="Right" IsDefault="True"
                Style="{StaticResource PrimaryButton}" Padding="16,8" />
    </StackPanel>
</Window>
