<Window x:Class="PesaControl.UI.Views.RegistroDetailPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Detalle del Pesaje"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,1" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="DetailField" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceMidBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding TicketInfo}" Style="{StaticResource SectionTitle}" FontSize="18" />
            <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{Binding StatusColor}" Margin="0,-5,0,10" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Patente" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding LicensePlate}" Style="{StaticResource DetailValue}" FontSize="20" FontWeight="Bold" />
                    </Border>

                    <TextBlock Text="Ticket" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding TicketNumber}" Style="{StaticResource DetailValue}" />
                    </Border>

                    <TextBlock Text="Producto" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding ProductName}" Style="{StaticResource DetailValue}" />
                    </Border>

                    <TextBlock Text="Empresa" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding CompanyName}" Style="{StaticResource DetailValue}" />
                    </Border>

                    <TextBlock Text="Operador" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding OperatorName}" Style="{StaticResource DetailValue}" />
                    </Border>

                    <TextBlock Text="Conductor" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding DriverName}" Style="{StaticResource DetailValue}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Peso de Entrada" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}" Background="{StaticResource SurfaceCardBrush}">
                        <TextBlock Text="{Binding GrossWeight, StringFormat={}{0:N3} kg}"
                                   Style="{StaticResource DetailValue}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                    </Border>

                    <TextBlock Text="Peso de Salida" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}" Background="{StaticResource SurfaceCardBrush}">
                        <TextBlock Text="{Binding TareWeight, StringFormat={}{0:N3} kg}"
                                   Style="{StaticResource DetailValue}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentOrangeBrush}" />
                    </Border>

                    <TextBlock Text="Peso Neto" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}" Background="{StaticResource SurfaceCardBrush}">
                        <TextBlock Text="{Binding NetWeight, StringFormat={}{0:N3} kg}"
                                   Style="{StaticResource DetailValue}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}" />
                    </Border>

                    <TextBlock Text="Fecha de Entrada" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding EntryDate}" Style="{StaticResource DetailValue}" />
                    </Border>

                    <TextBlock Text="Fecha de Salida" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}">
                        <TextBlock Text="{Binding ExitDate}" Style="{StaticResource DetailValue}" />
                    </Border>

                    <TextBlock Text="Notas" Style="{StaticResource DetailLabel}" />
                    <Border Style="{StaticResource DetailField}" MinHeight="30">
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource DetailValue}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Imprimir Ticket" Click="PrintTicket_Click"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="12,6" />
            <Button Content="Ver Fotos" Click="ShowPhotos_Click"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="12,6" />
            <Button Content="Cerrar" Click="Close_Click"
                    Style="{StaticResource WarningButton}" Padding="12,6" />
        </StackPanel>
    </Grid>
</Window>
