<UserControl x:Class="PesaControl.UI.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- MODE TOGGLE + CONTROL BAR -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <WrapPanel>
                    <Button Content="Cámara Individual"
                            Command="{Binding SwitchToCameraCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0" />
                    <Button Content="DVR Multicanal"
                            Command="{Binding SwitchToDvrCommand}"
                            Style="{StaticResource WarningButton}" />
                </WrapPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource StatusMessage}" />
            </StackPanel>
        </Border>

        <!-- CAMERA INDIVIDUAL MODE -->
        <Grid Grid.Row="1" Visibility="{Binding IsDvrMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardPanel}" Margin="0,8">
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding Cameras}"
                              SelectedItem="{Binding SelectedCamera}"
                              DisplayMemberPath="Name"
                              Width="280"
                              Margin="0,0,6,0" />
                    <Button Content="Conectar" Command="{Binding ConnectCommand}"
                            Style="{StaticResource SmallSuccessButton}"
                            Margin="0,0,6,0" />
                    <Button Content="Desconectar" Command="{Binding DisconnectCameraCommand}"
                            Style="{StaticResource SmallDangerButton}"
                            Margin="0,0,6,0" />
                    <Button Content="Capturar Foto" Command="{Binding CaptureStillCommand}"
                            Style="{StaticResource SmallButton}" />
                </WrapPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource DisplayPanel}" Padding="4">
                <Grid>
                    <Image Source="{Binding CurrentFrame}"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                    <Border Background="#1A000000" CornerRadius="4"
                            Padding="15,8" VerticalAlignment="Bottom"
                            HorizontalAlignment="Left" Margin="10">
                        <TextBlock Text="● EN VIVO"
                                   Foreground="{StaticResource AccentRedBrush}"
                                   FontSize="12" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Sin señal"
                               Style="{StaticResource EmptyStateText}" />
                </Grid>
            </Border>
        </Grid>

        <!-- DVR MULTICANAL MODE -->
        <Grid Grid.Row="1" Margin="0,8,0,0"
              Visibility="{Binding IsDvrMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- DVR control bar -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding DvrConfigs}"
                                  SelectedItem="{Binding SelectedDvrConfig}"
                                  DisplayMemberPath="Name"
                                  Width="240" Margin="0,0,6,0" />
                        <Button Content="Conectar" Command="{Binding ConnectDvrCommand}"
                                Style="{StaticResource SmallSuccessButton}"
                                Margin="0,0,6,0" />
                        <Button Content="Desconectar" Command="{Binding DisconnectDvrCommand}"
                                Style="{StaticResource SmallDangerButton}"
                                Margin="0,0,6,0" />

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0" />

                        <Button Content="▶ Todos" Command="{Binding ActivateAllChannelsCommand}"
                                Style="{StaticResource SmallButton}"
                                Margin="0,0,6,0" />
                        <Button Content="■ Detener" Command="{Binding StopAllDvrChannelsCommand}"
                                Style="{StaticResource SmallWarningButton}"
                                Margin="0,0,6,0" />
                        <Button Content="📷 Capturar Todo" Command="{Binding CaptureAllDvrSnapshotsCommand}"
                                Style="{StaticResource SmallWarningButton}"
                                Margin="0,0,6,0" />
                        <ToggleButton Content="⚙ Config"
                                      IsChecked="{Binding IsDvrSetupOpen}"
                                      Style="{StaticResource SmallToggleButton}" />
                    </WrapPanel>

                    <!-- Channel toggles + ANPR -->
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Canales:" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ToggleButton Content="CH1" IsChecked="{Binding DvrChannel1Active}"
                                      Style="{StaticResource SmallToggleButton}" Margin="0,0,4,0" />
                        <ToggleButton Content="CH2" IsChecked="{Binding DvrChannel2Active}"
                                      Style="{StaticResource SmallToggleButton}" Margin="0,0,4,0" />
                        <ToggleButton Content="CH3" IsChecked="{Binding DvrChannel3Active}"
                                      Style="{StaticResource SmallToggleButton}" Margin="0,0,4,0" />
                        <ToggleButton Content="CH4" IsChecked="{Binding DvrChannel4Active}"
                                      Style="{StaticResource SmallToggleButton}" Margin="0,0,12,0" />

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0" />

                        <TextBlock Text="ANPR:" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="8,0,4,0" />
                        <ComboBox SelectedItem="{Binding SelectedPtzChannel}"
                                  ItemsSource="{Binding ChannelNumbers}"
                                  Width="60" Margin="0,0,4,0" />
                        <Button Content="Capturar" Command="{Binding CaptureSelectedAnprCommand}"
                                Style="{StaticResource SmallButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- DVR Setup panel (collapsible) -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,8"
                    Visibility="{Binding IsDvrSetupOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 1 -->
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Nombre" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding DvrName}" Margin="0,0,0,8" />
                        <TextBlock Text="Dirección IP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding DvrIpAddress}" Margin="0,0,0,8" />
                        <TextBlock Text="Puerto HTTP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding DvrHttpPort}" Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- Column 2 -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Puerto RTSP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding DvrRtspPort}" Margin="0,0,0,8" />
                        <TextBlock Text="Usuario" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding DvrUsername}" Margin="0,0,0,8" />
                        <TextBlock Text="Contraseña" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding DvrPassword}" Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- Buttons row -->
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Button Content="Probar" Command="{Binding TestDvrConnectionCommand}"
                                Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                        <Button Content="Guardar" Command="{Binding SaveDvrConfigCommand}"
                                Style="{StaticResource SmallSuccessButton}" Margin="0,0,6,0" />
                        <Button Content="+ Nueva" Command="{Binding NewDvrConfigCommand}"
                                Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                        <Button Content="✕ Eliminar" Command="{Binding DeleteDvrConfigCommand}"
                                Style="{StaticResource SmallDangerButton}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding DvrSetupStatus}"
                               Style="{StaticResource StatusMessage}" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <!-- 2x2 GRID + PTZ SIDEBAR -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <!-- 2x2 Camera Grid -->
                <Border Style="{StaticResource DisplayPanel}" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CH1 -->
                        <Border Margin="3" Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="6" BorderBrush="{StaticResource SurfaceLightBrush}"
                                BorderThickness="1" Padding="4">
                            <Grid>
                                <Image Source="{Binding DvrFrame1}" Stretch="Uniform" />
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <Run Text="CH1 - " /><Run Text="{Binding DvrStatus1}" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                                    <TextBlock Text="{Binding DvrChannel1Plate}" FontSize="10"
                                               Foreground="{StaticResource AccentGreenBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CH2 -->
                        <Border Grid.Column="1" Margin="3" Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="6" BorderBrush="{StaticResource SurfaceLightBrush}"
                                BorderThickness="1" Padding="4">
                            <Grid>
                                <Image Source="{Binding DvrFrame2}" Stretch="Uniform" />
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <Run Text="CH2 - " /><Run Text="{Binding DvrStatus2}" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                                    <TextBlock Text="{Binding DvrChannel2Plate}" FontSize="10"
                                               Foreground="{StaticResource AccentGreenBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CH3 -->
                        <Border Grid.Row="1" Margin="3" Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="6" BorderBrush="{StaticResource SurfaceLightBrush}"
                                BorderThickness="1" Padding="4">
                            <Grid>
                                <Image Source="{Binding DvrFrame3}" Stretch="Uniform" />
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <Run Text="CH3 - " /><Run Text="{Binding DvrStatus3}" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                                    <TextBlock Text="{Binding DvrChannel3Plate}" FontSize="10"
                                               Foreground="{StaticResource AccentGreenBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CH4 -->
                        <Border Grid.Row="1" Grid.Column="1" Margin="3"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="6" BorderBrush="{StaticResource SurfaceLightBrush}"
                                BorderThickness="1" Padding="4">
                            <Grid>
                                <Image Source="{Binding DvrFrame4}" Stretch="Uniform" />
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4">
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <Run Text="CH4 - " /><Run Text="{Binding DvrStatus4}" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#80000000" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                                    <TextBlock Text="{Binding DvrChannel4Plate}" FontSize="10"
                                               Foreground="{StaticResource AccentGreenBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- PTZ Panel -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PTZ Control" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />

                        <TextBlock Text="Canal:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox SelectedItem="{Binding SelectedPtzChannel}"
                                  ItemsSource="{Binding ChannelNumbers}"
                                  Margin="0,0,0,8" />

                        <!-- D-pad -->
                        <Grid Width="130" Height="130" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="1" Content="▲"
                                    Command="{Binding PtzMoveCommand}"
                                    CommandParameter="Up"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="16" Padding="0" />
                            <Button Grid.Row="1" Content="◄"
                                    Command="{Binding PtzMoveCommand}"
                                    CommandParameter="Left"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="16" Padding="0" />
                            <Button Grid.Row="1" Grid.Column="2" Content="►"
                                    Command="{Binding PtzMoveCommand}"
                                    CommandParameter="Right"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="16" Padding="0" />
                            <Button Grid.Row="2" Grid.Column="1" Content="▼"
                                    Command="{Binding PtzMoveCommand}"
                                    CommandParameter="Down"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="16" Padding="0" />
                        </Grid>

                        <!-- Zoom -->
                        <TextBlock Text="Zoom" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="+" Command="{Binding PtzMoveCommand}"
                                    CommandParameter="ZoomIn"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="48" Height="32" FontSize="18" Margin="0,0,4,0" />
                            <Button Content="−" Command="{Binding PtzMoveCommand}"
                                    CommandParameter="ZoomOut"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="48" Height="32" FontSize="18" />
                        </WrapPanel>

                        <!-- Presets -->
                        <TextBlock Text="Presets" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <WrapPanel>
                            <Button Content="P1" Command="{Binding PtzGotoPresetCommand}"
                                    CommandParameter="1" Width="40"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,4,4" />
                            <Button Content="P2" Command="{Binding PtzGotoPresetCommand}"
                                    CommandParameter="2" Width="40"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,4,4" />
                            <Button Content="P3" Command="{Binding PtzGotoPresetCommand}"
                                    CommandParameter="3" Width="40"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,4,4" />
                            <Button Content="P4" Command="{Binding PtzGotoPresetCommand}"
                                    CommandParameter="4" Width="40"
                                    Style="{StaticResource SmallButton}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Guardar" Command="{Binding PtzSetPresetCommand}"
                                    CommandParameter="1"
                                    Style="{StaticResource SmallWarningButton}" Width="72" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- DETECTED PLATE (shared) -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Patente detectada:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding DetectedPlate}"
                           FontSize="32"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="{StaticResource AccentGreenBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="{Binding AnprConfidence, StringFormat={}{0:P0}}"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
