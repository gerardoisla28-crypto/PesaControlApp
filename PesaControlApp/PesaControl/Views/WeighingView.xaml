<UserControl x:Class="PesaControl.UI.Views.WeighingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:PesaControl.UI.Behaviors"
             xmlns:views="clr-namespace:PesaControl.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Weight displays + Form + Actions (centered) -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,15,0">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- Scale weight panels (1 or N) + connection controls -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding ScaleDisplays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DisplayPanel}" Padding="16"
                                    MinWidth="320" Margin="0,0,8,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Weight, StringFormat='{}{0:F1}kg'}"
                                               FontFamily="Consolas"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding IsStable, Converter={StaticResource BoolToGreenRedBrush}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                        <Setter Property="Foreground" Value="#FF3333" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Connection buttons beside scale panel -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,8">
                    <Button Content="Conectar"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="10,5" Margin="0,0,0,4" />
                    <Button Content="Desconectar"
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="10,5" />
                    <TextBlock Text="{Binding ScaleDisplays[0].StatusText}"
                               FontSize="11"
                               Foreground="{Binding ScaleDisplays[0].IsConnected, Converter={StaticResource ConnectedBrushConverter}}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Registration data: Patente + País + Conductor / Operador + Producto + Empresa -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Patente, País, Conductor -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                        <Label Content="Patente" Style="{StaticResource FormLabel}" Padding="0" Margin="0,0,0,2" />
                        <TextBox Text="{Binding LicensePlate}" Width="180"
                                 behaviors:TextBoxBehaviors.PlateCountry="{Binding PlateCountry}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                        <Label Content="País" Style="{StaticResource FormLabel}" Padding="0" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding Countries}"
                                  SelectedItem="{Binding PlateCountry}"
                                  MaxDropDownHeight="200" Width="70" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <Label Content="Conductor" Style="{StaticResource FormLabel}" Padding="0" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding DriversView}"
                                  Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  DisplayMemberPath="FullName"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  IsDropDownOpen="{Binding IsDriverDropdownOpen}"
                                  MaxDropDownHeight="200" />
                    </StackPanel>

                    <!-- Row 1: Operador, Producto, Empresa -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                        <Label Content="Operador" Style="{StaticResource FormLabel}" Padding="0" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding OperatorsView}"
                                  Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  DisplayMemberPath="FullName"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  IsDropDownOpen="{Binding IsOperatorDropdownOpen}"
                                  MaxDropDownHeight="200" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                        <Label Content="Producto" Style="{StaticResource FormLabel}" Padding="0" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="Name"
                                  MaxDropDownHeight="200" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                        <Label Content="Empresa" Style="{StaticResource FormLabel}" Padding="0" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding Companies}"
                                  SelectedItem="{Binding SelectedCompany}"
                                  DisplayMemberPath="Name"
                                  MaxDropDownHeight="200" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Weights + Actions + Active weighings list -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Combined: weight display + action buttons -->
                <Border Style="{StaticResource CardPanel}" Padding="10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Label Content="Peso Entrada" Style="{StaticResource FormLabel}"
                                   FontSize="12"
                                   Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center" />
                            <Border Background="{StaticResource SurfaceDarkBrush}"
                                    CornerRadius="6" Padding="10,4" MinWidth="100">
                                <TextBlock Text="{Binding EntryWeightText}"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Label Content="Peso Salida" Style="{StaticResource FormLabel}"
                                   FontSize="12"
                                   Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center" />
                            <Border Background="{StaticResource SurfaceDarkBrush}"
                                    CornerRadius="6" Padding="10,4" MinWidth="100">
                                <TextBlock Text="{Binding ExitWeightText}"
                                           FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Content="Marcar entrada"
                                    Command="{Binding StartWeighInCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Padding="6,4" Margin="3" MinWidth="75" />
                            <Button Content="Marcar salida"
                                    Command="{Binding CompleteWeighOutCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Padding="6,4" Margin="3" MinWidth="75" />
                            <Button Content="Cancelar pesaje"
                                    Command="{Binding CancelWeighingCommand}"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Padding="6,4" Margin="3" MinWidth="75" />
                            <Button Content="Nuevo pesaje"
                                    Command="{Binding NewWeighingCommand}"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Padding="6,4" Margin="3" MinWidth="75" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active weighings list -->
                <Border Grid.Row="1" Style="{StaticResource DisplayPanel}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="Pesajes del Día" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" DockPanel.Dock="Top" />
                            <ListBox ItemsSource="{Binding ActiveWeighings}"
                                     SelectedItem="{Binding SelectedRecord}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceMidBrush}"
                                                CornerRadius="4" Padding="8"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TicketNumber}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding LicensePlate}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding GrossWeight, StringFormat='E: {0:F1} kg'}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           Margin="8,0,8,0" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding TareWeight, StringFormat='S: {0:F1} kg'}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="4"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding WeighInTime, StringFormat='{}{0:HH:mm}'}" />
                                                    <Run Text="hs" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                 </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <StackPanel Grid.Row="1">
                            <Button Content="Imprimir Ticket"
                                    Command="{Binding PrintPreviewCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,6,0,0" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource StatusMessage}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>

        <!-- RIGHT: Camera + Barrier + Traffic light sidebar -->
        <views:WeighingSidebarView Grid.Column="2" />

        <GridSplitter Grid.Column="1" Width="0" />
    </Grid>
</UserControl>
