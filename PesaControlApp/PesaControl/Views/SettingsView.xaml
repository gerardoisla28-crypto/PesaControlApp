<UserControl x:Class="PesaControl.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:PesaControl.UI.Views.Controls"
             xmlns:ui="clr-namespace:PesaControl.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración del Sistema" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,0,0,8" />

        <TabControl x:Name="SettingsTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    SelectionChanged="SettingsTabs_SelectionChanged">
            <!-- TAB: Básculas -->
            <TabItem Header="Básculas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Scale list -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Básculas conectadas" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                            <ListBox ItemsSource="{Binding ScaleConfigs}"
                                     SelectedItem="{Binding SelectedScale}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceMidBrush}"
                                                CornerRadius="6" Padding="10" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                                         Fill="{Binding IsActive, Converter={StaticResource BoolToGreenRedBrush}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding PortName, StringFormat='{}{0}'}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ProtocolType}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="+ Agregar" Command="{Binding AddScaleCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                                <Button Content="✎ Editar" Command="{Binding EditScaleCommand}"
                                        Style="{StaticResource WarningButton}" Margin="0,0,6,0" />
                                <Button Content="✕ Eliminar" Command="{Binding DeleteScaleCommand}"
                                        Style="{StaticResource DangerButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{Binding ScaleStatusMessage}"
                               Style="{StaticResource StatusMessage}" />

                    <!-- Scale editor -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="20"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsScaleEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Configurar Báscula" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,12" />

                            <Label Content="Nombre" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding EditingScale.Name}" Margin="0,0,0,8" />

                            <CheckBox IsChecked="{Binding EditingScale.IsActive}" Content="Activa"
                                      Margin="0,0,0,8" />

                            <Label Content="Decimales del visor" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding WeightDecimalOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding EditingScale.WeightDecimals}"
                                      ToolTip="Automático detecta los decimales en protocolos de texto (ASCII, serial, Ethernet). En Modbus elija el número que muestra el visor."
                                      Margin="0,0,0,8" />

                            <Label Content="Seleccionar protocolo de comunicación" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding ProfileNames}"
                                      SelectedItem="{Binding SelectedProfileName}"
                                      Margin="0,0,0,8" />

                            <Label Content="Tipo de protocolo (ajuste manual)" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding ProtocolNames}"
                                      SelectedItem="{Binding SelectedProtocolName}"
                                      Margin="0,0,0,8" />

                            <Border Background="{StaticResource SurfaceDarkBrush}"
                                    CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                    Visibility="{Binding IsSerialProtocol, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Parámetros Serial" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Puerto" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding AvailablePorts}"
                                                      SelectedItem="{Binding EditingScale.PortName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Label Content="Baudrate" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding BaudRates}"
                                                      SelectedItem="{Binding EditingScale.BaudRate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0">
                                            <Label Content="Paridad" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding ParityOptions}"
                                                      SelectedItem="{Binding EditingScale.Parity}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="3,0">
                                            <Label Content="Data Bits" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding DataBitsOptions}"
                                                      SelectedItem="{Binding EditingScale.DataBits}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Margin="6,0,0,0">
                                            <Label Content="Stop Bits" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding StopBitsOptions}"
                                                      SelectedItem="{Binding EditingScale.StopBits}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Slave ID" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.SlaveId}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Label Content="Registro" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.RegisterAddress}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <Label Content="Intervalo (ms)" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.ReadIntervalMs}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceDarkBrush}"
                                    CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                    Visibility="{Binding IsTcpProtocol, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Parámetros Red (Modbus TCP)" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Dirección IP" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.IpAddress}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Label Content="Puerto TCP" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.TcpPort}" />
                                        </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="3,0">
                                                        <Label Content="Slave ID" Style="{StaticResource FormLabel}" />
                                                        <TextBox Text="{Binding EditingScale.SlaveId}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="3,0">
                                                        <Label Content="Registro" Style="{StaticResource FormLabel}" />
                                                        <TextBox Text="{Binding EditingScale.RegisterAddress}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" Margin="6,0,0,0">
                                                        <Label Content="Intervalo (ms)" Style="{StaticResource FormLabel}" />
                                                        <TextBox Text="{Binding EditingScale.ReadIntervalMs}" />
                                                    </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Parámetros Modbus configurables (RTU / ASCII / TCP) -->
                            <Border Background="{StaticResource SurfaceDarkBrush}"
                                    CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                    Visibility="{Binding IsModbusCfg, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Mapa de registros Modbus" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="La dirección de inicio es el campo «Registro» (dirección = registro − 30001 / 40001). Peso = valor leído ÷ divisor." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Función (3 = mantenidos, 4 = entrada)" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding ModbusFunctions}" SelectedItem="{Binding EditingScale.Options.Function}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Label Content="Tipo de dato" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding ModbusDataTypes}" SelectedItem="{Binding EditingScale.Options.DataType}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <Label Content="Divisor" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.Divisor}" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox Content="32 bits: registro bajo primero" IsChecked="{Binding EditingScale.Options.LowWordFirst}" Margin="0,0,16,0" />
                                        <CheckBox Content="Intercambiar bytes de cada registro" IsChecked="{Binding EditingScale.Options.SwapBytes}" />
                                    </WrapPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Reg. de estado (-1 = no usar)" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.StatusRegister}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Label Content="Bit de estabilidad" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.StableBit}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                            <CheckBox Content="Estable si el bit vale 1" IsChecked="{Binding EditingScale.Options.StableWhenSet}" Margin="0,0,0,6" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Reg. de comando (-1 = sin tara/cero)" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.CommandRegister}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Label Content="Valor para tara" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.TareValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <Label Content="Valor para cero" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.ZeroValue}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Parámetros ASCII configurables (serie/USB y Ethernet) -->
                            <Border Background="{StaticResource SurfaceDarkBrush}"
                                    CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                    Visibility="{Binding IsAsciiCfg, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Formato de trama ASCII" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Use \r (CR), \n (LF) y \t para los caracteres especiales. El patrón es una expresión regular; el peso es el primer valor que coincida." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Fin de trama" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.Terminator}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <Label Content="Comando de consulta (vacío = transmite solo)" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.PollCommand}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <Label Content="Divisor" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.Divisor}" />
                                        </StackPanel>
                                    </Grid>
                                    <Label Content="Patrón del peso" Style="{StaticResource FormLabel}" Margin="0,6,0,0" />
                                    <TextBox Text="{Binding EditingScale.Options.WeightPattern}" />
                                    <Label Content="Patrón de peso inestable (opcional, p. ej. US|MOT)" Style="{StaticResource FormLabel}" Margin="0,6,0,0" />
                                    <TextBox Text="{Binding EditingScale.Options.UnstablePattern}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Comando de tara (opcional)" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.TareCommand}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <Label Content="Comando de cero (opcional)" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding EditingScale.Options.ZeroCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Detectar equipo" Command="{Binding DetectEquipmentCommand}"
                                        Style="{StaticResource WarningButton}" Margin="0,0,8,0" />
                                <Button Content="Probar Conexión" Command="{Binding TestConnectionCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                <Button Content="Guardar" Command="{Binding SaveScaleCommand}"
                                        Style="{StaticResource SuccessButton}" Margin="0,0,8,0" />
                                <Button Content="Cancelar" Command="{Binding CancelScaleEditorCommand}"
                                        Style="{StaticResource DangerButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Puesto -->
            <TabItem Header="Puesto">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,15,0">
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Código del puesto" Style="{StaticResource SectionTitle}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Identifica este puesto en los números de ticket (por ejemplo STGO-2026-10-0001). Ejemplos: Santiago = STGO, Región Metropolitana = RM." />

                                <Label Content="Código (1 a 4 caracteres, letras y números) *" Style="{StaticResource FormLabel}" />
                                <TextBox Text="{Binding StationCode, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="4" CharacterCasing="Upper" Width="160" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding StationCodeError}" Foreground="{StaticResource AccentRedBrush}"
                                           FontSize="12" TextWrapping="Wrap" MinHeight="16" Margin="2,3,0,6" />

                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{StaticResource AccentOrangeBrush}"
                                           Text="Cada puesto de la empresa debe tener un código distinto. Si lo cambia, los tickets ya emitidos conservan su código y los nuevos empiezan una serie nueva." />

                                <TextBlock Text="* Campo obligatorio" FontSize="12" Margin="0,0,0,10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button Content="Guardar" Command="{Binding SaveStationCodeCommand}"
                                        Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding StationCodeMessage}" Style="{StaticResource StatusMessage}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Modo operación -->
            <TabItem Header="Red">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,15,0">
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Modo de Operación" Style="{StaticResource SectionTitle}" />

                                <Label Content="Modo" Style="{StaticResource FormLabel}" />
                                <ComboBox ItemsSource="{Binding ModeNames}"
                                          SelectedItem="{Binding SelectedModeName}"
                                          Margin="0,0,0,12" />

                                <Border Background="{StaticResource SurfaceDarkBrush}"
                                        CornerRadius="6" Padding="12"
                                        Visibility="{Binding SelectedModeName, Converter={StaticResource StringVisibilityConverter}, ConverterParameter=Servidor}">
                                    <StackPanel>
                                        <TextBlock Text="Configuración de Servidor" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <Label Content="Puerto" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding ServerPort}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource SurfaceDarkBrush}"
                                        CornerRadius="6" Padding="12"
                                        Visibility="{Binding SelectedModeName, Converter={StaticResource StringVisibilityConverter}, ConverterParameter=Cliente}">
                                    <StackPanel>
                                        <TextBlock Text="Configuración de Cliente" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <Label Content="URL del Servidor" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding ServerUrl}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Guardar Configuración" Command="{Binding SaveConfigCommand}"
                                    Style="{StaticResource SuccessButton}" Margin="0,0,8,0" />
                            <Button Content="Recargar" Command="{Binding LoadConfigCommand}"
                                    Style="{StaticResource WarningButton}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource StatusMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Respaldo -->
            <TabItem Header="Respaldo">
                <views:BackupControl DataContext="{Binding BackupVM}" />
            </TabItem>

            <!-- TAB: Cámaras (antes una sección del menú, ahora solo para el administrador) -->
            <TabItem Header="Cámaras">
                <ui:CameraView DataContext="{Binding CameraVM}" />
            </TabItem>

            <!-- TAB: Control de acceso (barrera y semáforo) -->
            <TabItem Header="Control"
                     Visibility="{Binding IsControlModuleEnabled, Converter={StaticResource BoolToVis}}">
                <ui:ControlsView DataContext="{Binding ControlsVM}" />
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
