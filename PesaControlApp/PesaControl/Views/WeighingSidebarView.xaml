<UserControl x:Class="PesaControl.UI.Views.WeighingSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="340"
             Foreground="{StaticResource TextPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="TrafficLightCircle" TargetType="Ellipse">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Fill" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="0" Opacity="0" ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrafficLightGlow" TargetType="Ellipse" BasedOn="{StaticResource TrafficLightCircle}">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ CAMERA SECTION ═══════ -->
        <Border Style="{StaticResource CardPanel}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="CÁMARA" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />

                <!-- Camera selector -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <ComboBox ItemsSource="{Binding CameraVM.Cameras}"
                              SelectedItem="{Binding CameraVM.SelectedCamera}"
                              DisplayMemberPath="Name"
                              Width="200"
                              FontSize="11"
                              Margin="0,0,4,0" />
                    <Button Content="⛔" Command="{Binding CameraVM.DisconnectCommand}"
                            Width="28" Height="22" FontSize="12"
                            Style="{StaticResource DangerButton}"
                            Padding="0" />
                </WrapPanel>

                <!-- Live preview -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceDarkBrush}"
                        CornerRadius="6" Padding="4" MinHeight="150"
                        Cursor="Hand" MouseDown="CameraPreview_MouseDown">
                    <Grid>
                        <Image Source="{Binding CameraVM.CurrentFrame}"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                        <TextBlock Text="Sin conexión"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding CameraVM.IsPreviewRunning, Converter={StaticResource InverseBoolToVis}}" />

                        <Border Background="#1A000000" CornerRadius="4"
                                Padding="8,4" VerticalAlignment="Bottom"
                                HorizontalAlignment="Left" Margin="6"
                                Visibility="{Binding CameraVM.IsPreviewRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="● EN VIVO"
                                       Foreground="{StaticResource AccentRedBrush}"
                                       FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Patente detectada (se muestra solo cuando hay detección) -->
                <Border Grid.Row="3" Margin="0,6,0,0" Padding="6,4"
                        Background="{StaticResource SurfaceDarkBrush}" CornerRadius="4"
                        DataContext="{Binding CameraVM}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="5">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="6">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="7">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="8">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="9">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="10">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="11">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="12">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="13">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="14">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedPlate.Length}" Value="15">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DetectedPlate}"
                                   FontSize="18" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AnprConfidence, StringFormat={}{0:P0}}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Conectar button -->
                <Button Grid.Row="4" Content="Conectar cámara"
                        Command="{Binding CameraVM.ConnectCommand}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="11" Padding="8,4"
                        HorizontalAlignment="Stretch"
                        Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- ═══════ ACCESS CONTROL SECTION ═══════ -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="CONTROL ACCESO" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10" />

                <!-- Barrier buttons -->
                <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button Content="ABRIR"
                            Command="{Binding ControlsVM.BarrierVM.OpenCommand}"
                            IsEnabled="{Binding ControlsVM.BarrierVM.IsConnected}"
                            Style="{StaticResource SuccessButton}"
                            FontSize="14" FontWeight="Bold"
                            Padding="20,10" Margin="0,0,6,0"
                            MinWidth="100" />
                    <Button Content="CERRAR"
                            Command="{Binding ControlsVM.BarrierVM.CloseCommand}"
                            IsEnabled="{Binding ControlsVM.BarrierVM.IsConnected}"
                            Style="{StaticResource DangerButton}"
                            FontSize="14" FontWeight="Bold"
                            Padding="20,10"
                            MinWidth="100" />
                </WrapPanel>

                <!-- Traffic light visual -->
                <Border Grid.Row="2" CornerRadius="10" Padding="16"
                        Background="{StaticResource SurfaceDarkBrush}"
                        HorizontalAlignment="Center" Width="140"
                        VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SEMÁFORO" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,14" />

                        <!-- RED LIGHT -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Ellipse Width="48" Height="48" StrokeThickness="2">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#3DF44336" />
                                        <Setter Property="Stroke" Value="#66F44336" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="0" Opacity="0" ShadowDepth="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ControlsVM.BarrierVM.IsOpen}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource AccentRedBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentRedBrush}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="16" Opacity="0.7"
                                                                          ShadowDepth="0" Color="#F44336" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>

                        <!-- GREEN LIGHT -->
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="48" Height="48" StrokeThickness="2">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#1D4CAF50" />
                                        <Setter Property="Stroke" Value="#664CAF50" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="0" Opacity="0" ShadowDepth="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ControlsVM.BarrierVM.IsOpen}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentGreenBrush}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="16" Opacity="0.7"
                                                                          ShadowDepth="0" Color="#4CAF50" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>

                        <!-- Status text -->
                        <Border CornerRadius="4" Padding="10,4" Margin="0,14,0,0"
                                Background="{Binding ControlsVM.BarrierVM.IsOpen, Converter={StaticResource BoolToGreenRedBrush}}">
                            <TextBlock Text="{Binding ControlsVM.BarrierVM.IsOpen, Converter={StaticResource BoolToOpenClosed}}"
                                       HorizontalAlignment="Center" FontWeight="Bold"
                                       Foreground="White" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
