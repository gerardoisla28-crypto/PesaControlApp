<Window x:Class="PesaControl.UI.Views.FotoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fotos del Pesaje"
        Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="PhotoBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding TicketInfo, FallbackValue='Fotos del pesaje'}"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource PhotoBox}" Margin="0,0,0,10"
                        Visibility="{Binding HasEntryPhoto, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Foto de entrada" FontWeight="Bold" Margin="0,0,0,6" />
                        <Image Source="{Binding EntryPhotoSource}"
                               MaxHeight="300"
                               Stretch="Uniform" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PhotoBox}"
                        Visibility="{Binding HasExitPhoto, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Foto de salida" FontWeight="Bold" Margin="0,0,0,6" />
                        <Image Source="{Binding ExitPhotoSource}"
                               MaxHeight="300"
                               Stretch="Uniform" />
                    </StackPanel>
                </Border>

                <TextBlock Text="No hay fotos disponibles"
                           Visibility="{Binding NoPhotos, Converter={StaticResource BoolToVis}}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Cerrar"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="Close_Click" />
    </Grid>
</Window>
