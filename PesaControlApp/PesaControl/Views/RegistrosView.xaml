<UserControl x:Class="PesaControl.UI.Views.RegistrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:PesaControl.Core.Models"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FILTERS -->
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Historial de Pesajes" Style="{StaticResource SectionTitle}" />

                <WrapPanel Margin="0,0,0,10">
                    <StackPanel Margin="0,0,6,0">
                        <TextBox Text="{Binding SearchPlate, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140" ToolTip="Buscar por patente" />
                        <TextBlock Text="Patente" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,6,0">
                        <TextBox Text="{Binding SearchTicket, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" ToolTip="Buscar por ticket" />
                        <TextBlock Text="Ticket" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,6,0">
                        <DatePicker SelectedDate="{Binding FilterFrom}"
                                    Width="120" ToolTip="Desde" />
                        <TextBlock Text="Desde" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,6,0">
                        <DatePicker SelectedDate="{Binding FilterTo}"
                                    Width="120" ToolTip="Hasta" />
                        <TextBlock Text="Hasta" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,6,0">
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding FilterStatus}"
                                  Width="130" ToolTip="Filtrar por estado">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource WeighingStatusConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Estado" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,6,0">
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding FilterProduct}"
                                  DisplayMemberPath="Name"
                                  Width="140" ToolTip="Filtrar por producto" />
                        <TextBlock Text="Producto" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,6,0">
                        <ComboBox ItemsSource="{Binding Companies}"
                                  SelectedItem="{Binding FilterCompany}"
                                  DisplayMemberPath="Name"
                                  Width="140" ToolTip="Filtrar por empresa" />
                        <TextBlock Text="Empresa" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,6,0" Visibility="{Binding CanExchange, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding ExportOptions}"
                                  SelectedItem="{Binding FilterExport}"
                                  Width="130" ToolTip="Filtrar por estado de exportación" />
                        <TextBlock Text="Exportación" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                </WrapPanel>

                <WrapPanel>
                    <Button Content="Buscar" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" />
                    <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource WarningButton}" Margin="0,0,4,0" />
                    <Button Content="Imprimir" Command="{Binding PrintTicketCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusMessage}" VerticalAlignment="Center" />
                </WrapPanel>

                <!-- Intercambio entre puestos (pendrive): solo para quien puede exportar e importar -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding CanExchange, Converter={StaticResource BoolToVis}}">
                    <Separator Background="{StaticResource SurfaceLightBrush}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="Seleccionar todos" Command="{Binding SelectAllFilteredCommand}"
                                ToolTip="Marca todos los pesajes del filtro actual, en todas las páginas"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" />
                        <Button Content="Quitar selección" Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SelectionText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="Exportar seleccionados" Command="{Binding ExportSelectedCommand}"
                                ToolTip="Crea un archivo con los pesajes marcados para llevarlo a otro equipo"
                                Style="{StaticResource SuccessButton}" Margin="0,0,4,0" />
                        <Button Content="Importar archivo" Command="{Binding ImportFileCommand}"
                                ToolTip="Une los pesajes de un archivo de otro puesto con los de este equipo"
                                Style="{StaticResource PrimaryButton}" />
                    </WrapPanel>
                    <ProgressBar Value="{Binding ProgressValue}" Height="8" BorderThickness="0" Margin="0,8,0,0"
                                 Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource SurfaceLightBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RECORDS LIST -->
        <Border Grid.Row="1" Style="{StaticResource DisplayPanel}" Padding="4">
            <Grid>
                <ListView ItemsSource="{Binding Records}"
                          SelectedItem="{Binding SelectedRecord}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          MouseDoubleClick="ListView_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SidebarItemHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SidebarItemHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Padding" Value="8,4,8,4" />
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn x:Name="CheckColumn" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForExport, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Marcar para exportar" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ticket" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TicketNumber}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ExportColumn" Header="Exportación" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Exportado" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExportPending}" Value="True">
                                                            <Setter Property="Text" Value="Pendiente" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fecha Entrada" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WeighInTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fecha Salida" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WeighOutTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Patente" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LicensePlate}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Producto" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Product.Name}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Empresa" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Company.Name}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Operador" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OperatorName}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Conductor" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DriverName}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Peso Entrada" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GrossWeight, StringFormat={}{0:N3}}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Peso Salida" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TareWeight, StringFormat={}{0:N3}}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Peso Neto" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NetWeight, StringFormat={}{0:N3}}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Estado" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource WeighingStatusConverter}}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Cámara" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📷"
                                                Command="{Binding DataContext.ShowPhotosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                FontSize="14"
                                                ToolTip="Ver fotos del pesaje"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Text="Sin registros"
                           Style="{StaticResource EmptyStateText}"
                           Visibility="{Binding Records.Count, Converter={StaticResource EmptyToVis}}" />
            </Grid>
        </Border>

        <!-- PAGINATION -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding PageInfo}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&lt;&lt;"
                            Command="{Binding GoToPageCommand}"
                            CommandParameter="1"
                            IsEnabled="{Binding HasPreviousPage}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="&lt; Anterior"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="Siguiente &gt;"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="8,4" Margin="0,0,4,0" />
                    <Button Content="&gt;&gt;"
                            Command="{Binding GoToPageCommand}"
                            CommandParameter="{Binding TotalPages}"
                            IsEnabled="{Binding HasNextPage}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="8,4" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
