<Window x:Class="PesaControl.UI.Views.CameraPreviewPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, FallbackValue='Vista de cámara'}"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="8" Padding="8">
            <Image Source="{Binding FrameSource}"
                   Stretch="Uniform"
                   MaxWidth="760"
                   MaxHeight="520"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />
        </Border>

        <Button Grid.Row="1" Content="Cerrar"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="Close_Click" />
    </Grid>
</Window>
