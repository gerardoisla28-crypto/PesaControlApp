<UserControl x:Class="PesaControl.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="350" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: User list -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Usuarios del Sistema" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1">
                        <Button Content="Configurar Usuarios" Command="{Binding ToggleEditorCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource StatusMessage}"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- User list -->
            <Border Grid.Row="1" Style="{StaticResource DisplayPanel}" Padding="4">
                <ListBox ItemsSource="{Binding Users}"
                         SelectedItem="{Binding SelectedUser}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="12"
                                    Margin="0,0,0,4"
                                    Background="{StaticResource SurfaceMidBrush}"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Width="36" Height="36"
                                            Background="{StaticResource AccentBlueBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}"
                                                   FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding FullName}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2"
                                            Background="{StaticResource SurfaceLightBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

        </Grid>

        <!-- SEPARATOR -->
        <GridSplitter Grid.Column="1" Width="3" Margin="10,0"
                      Background="{StaticResource SurfaceLightBrush}"
                      VerticalAlignment="Stretch"
                      IsEnabled="{Binding IsEditorOpen}" />

        <!-- RIGHT: Editor panel -->
        <Border Grid.Column="2" Style="{StaticResource CardPanel}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,0">
            <StackPanel>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                            <Setter Property="Text" Value="Nuevo Usuario" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Text" Value="Editar Usuario" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Label Content="Nombre de usuario" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding EditUsername}" Margin="0,0,0,8" />

                <Label Content="Nombre completo" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding EditFullName}" Margin="0,0,0,8" />

                <Label Content="Email" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding EditEmail}" Margin="0,0,0,8" />

                <Label Content="Rol" Style="{StaticResource FormLabel}" />
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding EditRole}"
                          Margin="0,0,0,8" />

                <Label Content="Contraseña" Style="{StaticResource FormLabel}" />
                <PasswordBox Margin="0,0,0,8" PasswordChanged="PasswordBox_OnPasswordChanged"
                             ToolTip="Entre 14 y 128 caracteres. Dejar vacío para mantener la actual al editar." />

                <CheckBox Content="Usuario activo"
                          IsChecked="{Binding EditIsActive}"
                          Margin="0,0,0,16"
                          Foreground="{StaticResource TextPrimaryBrush}" />

                <WrapPanel>
                    <Button Content="Guardar" Command="{Binding SaveUserCommand}"
                            Style="{StaticResource SuccessButton}"
                            Margin="0,0,6,0" Padding="20,10" />
                    <Button Content="Cancelar" Command="{Binding CancelEditCommand}"
                            Style="{StaticResource WarningButton}"
                            Margin="0,0,6,0" Padding="20,10" />
                    <Button Content="Eliminar" Command="{Binding DeleteUserCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="20,10"
                            IsEnabled="{Binding IsEditing}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
