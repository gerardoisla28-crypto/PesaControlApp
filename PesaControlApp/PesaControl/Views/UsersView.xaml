<UserControl x:Class="PesaControl.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Foreground="{StaticResource TextPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-4,0,8" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="350" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: User list -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Usuarios del Sistema" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1">
                        <Button Content="Crear Usuario" Command="{Binding NewUserCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource StatusMessage}"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- User list -->
            <Border Grid.Row="1" Style="{StaticResource DisplayPanel}" Padding="4">
                <ListBox ItemsSource="{Binding Users}"
                         SelectedItem="{Binding SelectedUser}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="12"
                                    Margin="0,0,0,4"
                                    Background="{StaticResource SurfaceMidBrush}"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Width="36" Height="36"
                                            Background="{StaticResource AccentBlueBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}"
                                                   FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding FullName}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2"
                                            Background="{StaticResource SurfaceLightBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Role, Converter={StaticResource RoleName}}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Background="{StaticResource AccentAmberBrush}"
                                                Padding="8,6" Margin="0,0,6,0"
                                                ToolTip="Editar"
                                                Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" />
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}"
                                                Padding="8,6"
                                                ToolTip="Eliminar"
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

        </Grid>

        <!-- SEPARATOR -->
        <GridSplitter Grid.Column="1" Width="3" Margin="10,0"
                      Background="{StaticResource SurfaceLightBrush}"
                      VerticalAlignment="Stretch"
                      IsEnabled="{Binding IsEditorOpen}" />

        <!-- RIGHT: Editor panel -->
        <Border Grid.Column="2" Style="{StaticResource CardPanel}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,0">
            <StackPanel>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                            <Setter Property="Text" Value="Nuevo Usuario" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Text" Value="Editar Usuario" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Label Content="Nombre de usuario" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding EditUsername}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding UsernameError}" Style="{StaticResource FieldError}" />

                <Label Content="Nombre completo" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding EditFullName}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding FullNameError}" Style="{StaticResource FieldError}" />

                <Label Content="Rol" Style="{StaticResource FormLabel}" />
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding EditRole}"
                          Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RoleName}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding RoleError}" Style="{StaticResource FieldError}" />

                <Label Content="Contraseña" Style="{StaticResource FormLabel}" />
                <TextBlock Text="Al editar, dejar vacío para mantener la contraseña actual."
                           FontSize="11" Margin="0,-2,0,4" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,8" PasswordChanged="PasswordBox_OnPasswordChanged"
                             Style="{StaticResource MaterialDesignRevealPasswordBox}"
                             ToolTip="Entre 14 y 128 caracteres para SuperAdmin y Admin; entre 8 y 128 para Operator y Viewer. Dejar vacío para mantener la actual al editar." />
                <TextBlock Text="{Binding PasswordError}" Style="{StaticResource FieldError}" />

                <Label Content="Confirmar contraseña" Style="{StaticResource FormLabel}" />
                <PasswordBox x:Name="ConfirmPasswordInput" Margin="0,0,0,8" PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                             Style="{StaticResource MaterialDesignRevealPasswordBox}"
                             ToolTip="Repita la contraseña." />
                <TextBlock Text="{Binding PasswordConfirmError}" Style="{StaticResource FieldError}" />

                <CheckBox Content="Usuario activo"
                          IsChecked="{Binding EditIsActive}"
                          Margin="0,0,0,16"
                          Foreground="{StaticResource TextPrimaryBrush}" />

                <WrapPanel>
                    <Button Content="Guardar" Command="{Binding SaveUserCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0" Padding="20,10" />
                    <Button Content="Cancelar" Command="{Binding CancelEditCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="20,10" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
