<Window x:Class="PesaControl.UI.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambios sin guardar" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <StackPanel Margin="28,24,28,24">
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock Text="¿Desea continuar sin guardar los cambios?" FontSize="18" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,22" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="Guardar y continuar" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Padding="14,8" />
            <Button Content="Continuar sin guardar" Click="Discard_Click"
                    Style="{StaticResource WarningButton}" Margin="0,0,8,0" Padding="14,8" />
            <Button Content="Cancelar" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource PrimaryButton}" Padding="14,8" />
        </WrapPanel>
    </StackPanel>
</Window>
