<Window x:Class="PesaControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PesaControl Pro - Login"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Margin" Value="2,3,0,6" />
        </Style>
    </Window.Resources>
    <Border CornerRadius="8" Background="{StaticResource SurfaceCardBrush}"
            Margin="0" BorderThickness="1"
            BorderBrush="{StaticResource SurfaceLightBrush}">
        <Grid>
        <StackPanel Margin="30,30,30,22">
            <!-- Logo -->
            <StackPanel Margin="0,10,0,20" HorizontalAlignment="Center">
                <TextBlock Text="⚖" FontSize="36" HorizontalAlignment="Center" />
                <TextBlock Text="PESA CONTROL" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="White" />
                <TextBlock Text="Iniciar Sesión" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>

            <TextBlock x:Name="InfoText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{StaticResource AccentGreenBrush}" />

            <TextBlock Text="Usuario" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="txtUser" FontSize="14"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Escriba su usuario"
                     materialDesign:HintAssist.IsFloating="False" />
            <TextBlock x:Name="UserError" Style="{StaticResource FieldError}" />

            <TextBlock Text="Contraseña" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" Margin="0,0,0,4" />
            <PasswordBox x:Name="txtPass" FontSize="14"
                         Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                         materialDesign:HintAssist.Hint="Escriba su contraseña"
                         materialDesign:HintAssist.IsFloating="False" />
            <TextBlock x:Name="PassError" Style="{StaticResource FieldError}" />

            <TextBlock x:Name="ErrorText" Style="{StaticResource FieldError}" MinHeight="0" Margin="0,0,0,10" />

            <Button x:Name="LoginButton" Content="Ingresar" FontSize="15" FontWeight="Bold"
                    Padding="15,9" IsDefault="True"
                    Click="Login_Click"
                    Style="{StaticResource PrimaryButton}" />

            <TextBlock Text="v1.0.0"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" HorizontalAlignment="Center"
                       Margin="0,20,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,8,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="—" FontSize="14" ToolTip="Minimizar"
                    Width="30" Height="30" Padding="0"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Click="Minimize_Click" IsTabStop="False" />
            <Button Content="✕" FontSize="14" ToolTip="Cerrar (Esc)"
                    Width="30" Height="30" Padding="0"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Click="Close_Click" IsTabStop="False" />
        </StackPanel>
        </Grid>
    </Border>
</Window>
