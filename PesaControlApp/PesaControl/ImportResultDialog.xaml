<Window x:Class="PesaControl.UI.ImportResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultado de la importación" Width="640" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <StackPanel Margin="26,22,26,22">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel x:Name="ConflictsPanel" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,0,8"
                       Text="Estos datos son distintos en este equipo y en el archivo. Se conservó el valor de este equipo; si el del archivo era el correcto, corríjalo a mano." />
            <ListView x:Name="ConflictsList" Background="{StaticResource SurfaceCardBrush}" BorderThickness="0" MaxHeight="260">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Ticket" Width="150" DisplayMemberBinding="{Binding TicketNumber}" />
                        <GridViewColumn Header="Dato" Width="130" DisplayMemberBinding="{Binding Field}" />
                        <GridViewColumn Header="Este equipo" Width="150" DisplayMemberBinding="{Binding LocalValue}" />
                        <GridViewColumn Header="Archivo" Width="150" DisplayMemberBinding="{Binding IncomingValue}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <Button Content="Aceptar" Click="Close_Click" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="0,16,0,0" />
    </StackPanel>
</Window>
