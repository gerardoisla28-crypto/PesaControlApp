<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surface / Background -->
    <Color x:Key="SurfaceDark">#F3F4F6</Color>
    <Color x:Key="SurfaceMid">#E5E7EB</Color>
    <Color x:Key="SurfaceLight">#D1D5DB</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#1F2937</Color>
    <Color x:Key="TextSecondary">#4B5563</Color>
    <Color x:Key="TextMuted">#6B7280</Color>

    <!-- Brand / Accent -->
    <Color x:Key="AccentGreen">#4CAF50</Color>
    <Color x:Key="AccentRed">#F44336</Color>
    <Color x:Key="AccentBlue">#2196F3</Color>
    <Color x:Key="AccentOrange">#FF9800</Color>
    <Color x:Key="AccentTeal">#009688</Color>
    <Color x:Key="AccentAmber">#FFC107</Color>

    <!-- Sidebar -->
    <Color x:Key="SidebarBg">#FFFFFF</Color>
    <Color x:Key="SidebarItemHover">#E5E7EB</Color>
    <Color x:Key="SidebarItemActive">#90CAF9</Color>
    <Color x:Key="SidebarItemSelected">#BBDEFB</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}" />
    <SolidColorBrush x:Key="SurfaceMidBrush" Color="{StaticResource SurfaceMid}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrange}" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTeal}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmber}" />

    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHover}" />
    <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="{StaticResource SidebarItemActive}" />
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="{StaticResource SidebarItemSelected}" />
</ResourceDictionary>
