<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PesaControl.UI.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToBrushConverter x:Key="BoolToGreenRedBrush"
                                TrueBrush="#4CAF50" FalseBrush="#F44336" />
    <conv:BoolToBrushConverter x:Key="ConnectedBrushConverter"
                                TrueBrush="#4CAF50" FalseBrush="#FF9800" />
    <conv:BoolToStringConverter x:Key="BoolToOpenClosed"
                                TrueString="Abierta" FalseString="Cerrada" />
    <conv:ConfidenceToBrushConverter x:Key="ConfidenceBrush" />
    <conv:CountToVisibilityConverter x:Key="EmptyToVis" />
    <conv:WeighingStatusConverter x:Key="WeighingStatusConverter" />
    <conv:TrafficLightColorToBrushConverter x:Key="TrafficLightColorBrush" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:StringVisibilityConverter x:Key="StringVisibilityConverter" />
</ResourceDictionary>
