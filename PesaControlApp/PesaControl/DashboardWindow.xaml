<Window x:Class="PesaControl.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PesaControl.UI.ViewModels"
        x:Name="DashboardRoot"
        Title="PesaControl Pro - Dashboard"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource SurfaceDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" BorderBrush="{StaticResource SurfaceLightBrush}"
                        BorderThickness="0,0,0,1" Padding="0,20,0,15">
                    <StackPanel>
                        <TextBlock Text="⚖" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="PESA CONTROL" Style="{StaticResource SidebarTitle}"
                                   HorizontalAlignment="Center" Margin="0" />
                        <TextBlock Text="Industrial Weighing System"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,5,0,0">
                    <Button Content="    Pesaje" Command="{Binding ShowWeighingCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Pesaje">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="    Cámaras" Command="{Binding ShowCamerasCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Camaras">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="    Registros" Command="{Binding ShowRegistrosCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Registros">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="    Control" Command="{Binding ShowControlsCommand}"
                            Visibility="{Binding IsControlModuleEnabled, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Control">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="    Usuarios" Command="{Binding ShowUsersCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Usuarios">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="    Catálogos" Command="{Binding ShowCatalogsCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Catalogos">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="    Configuración" Command="{Binding ShowSettingsCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Configuracion">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="    Reportes" Command="{Binding ShowReportsCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Reportes">
                                        <Setter Property="Background" Value="{StaticResource SidebarItemSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Version -->
                <StackPanel Grid.Row="3" Margin="15,0,15,15">
                    <Separator Background="{StaticResource SurfaceLightBrush}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="v1.0.0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" Margin="15" CornerRadius="8"
                Background="{StaticResource SurfaceCardBrush}">
            <ContentControl Content="{Binding CurrentViewModel}" Focusable="False" />
        </Border>
    </Grid>
</Window>
